# 复制为项目根目录 .env 后修改（勿提交 Git）
# cp deploy/env.example .env

# ── 数据库（docker-compose 内 MySQL）──
DB_HOST=mysql
DB_PORT=3306
DB_USER=backpack
DB_PASSWORD=请修改为强密码
DB_NAME=backpack

# ── 服务标识（生产环境开启加密评分等）──
TRADING_SERVER=1
ENABLE_OKX_TRADE=true

# ── 交易所 API（按需填写）──
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
HYPERLIQUID_PRIVATE_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
DEEPCOIN_API_KEY=
DEEPCOIN_SECRET_KEY=
DEEPCOIN_PASSPHRASE=
OSTIUM_PRIVATE_KEY=

# ── Webhook / 钉钉 ──
WEBHOOK_SECRET=your-secret-key-here
DINGTALK_TOKEN=
DINGTALK_SECRET=

# ── 行情数据 ──
MASSIVE_API_KEY=

# ── AI 评分（可选）──
DEEPSEEK_SCORE_MODEL=deepseek-v4-flash
CRYPTO_SCORE_ENABLED=1

# ── 评分反馈学习（Chroma 向量库，钉钉 @ 纠正评分）──
SCORE_FEEDBACK_CHROMA_ENABLED=1
# SCORE_FEEDBACK_CHROMA_PATH=backpack_quant_trading/data/chroma_score_feedback

# ── Agent 编排（钉钉多分析师 / 记忆 / 确认下单）──
AGENT_ORCH_ENABLED=1
# 独立 Agent Stream 机器人（推荐：与旧 OpenClaw 小钉评分机器人分开，互不抢连接）
# DINGTALK_AGENT_BOT_CLIENT_ID=
# DINGTALK_AGENT_BOT_CLIENT_SECRET=
# 独立 Agent 机器人默认关闭旧「信号评分」；若要在新机器人上也评分则设为 1
# DINGTALK_AGENT_ALLOW_LEGACY_SCORE=0
AGENT_MEMORY_CHROMA_ENABLED=1
# AGENT_EXEC_CONFIRM_TTL_MIN=30
# WEBHOOK_BASE=http://webhook:8005
# 确认实盘必须：有效 WEBHOOK_SECRET + 已注册实例 ID（禁止广播）
# AGENT_EXEC_INSTANCE_ID=
# AGENT_SIGNAL_PUSH_ENABLED=0
# AGENT_REPLACE_LEGACY_PUSH=0
# AGENT_E2E_MOCK_LLM=0

# ── 旧评分 Stream（OpenClaw 小钉，可继续本机或其他进程使用）──
# DINGTALK_SCORE_BOT_CLIENT_ID=
# DINGTALK_SCORE_BOT_CLIENT_SECRET=
# DINGTALK_MANUAL_SCORE_ENABLED=1

# ── 加密密钥口令（若有 .env.secrets）──
# ENV_SECRETS_PASSPHRASE=
