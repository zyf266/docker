# 复制为项目根目录 .env 后修改（勿提交 Git）
# cp deploy/env.example .env
# 正式机请参考 deploy/env.prod.example

# ── 数据库 ──
# 测试机 / 本地 compose MySQL：DB_HOST=mysql（deploy.sh 会启 profile local-mysql）
# 正式机外部 MySQL：DB_HOST=host.docker.internal 或 172.17.0.1（并 SKIP_MYSQL=1）
DB_HOST=mysql
DB_PORT=3306
DB_USER=backpack
DB_PASSWORD=请修改为强密码
DB_NAME=backpack

# ── 出站代理（宿主机 Clash/mihomo；容器经 Docker bridge 访问）──
# 正式机示例（mihomo mixed 端口默认 7891）：
# HTTP_PROXY=http://host.docker.internal:7891
# HTTPS_PROXY=http://host.docker.internal:7891
# NO_PROXY=localhost,127.0.0.1,mysql,api,webhook,dingtalk-agent,host.docker.internal
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,mysql,api,webhook,dingtalk-agent,host.docker.internal

# ── 服务标识（生产环境开启加密评分等）──
TRADING_SERVER=1
ENABLE_OKX_TRADE=true

# ── 交易所 API（按需填写）──
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
HYPERLIQUID_PRIVATE_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# 合约保证金模式：ISOLATED=逐仓（默认） / CROSSED=全仓
BINANCE_MARGIN_TYPE=ISOLATED
# 币安是否走 HTTPS_PROXY（默认走）。若 API Key IP 白名单只放了服务器公网 IP，设 BINANCE_USE_PROXY=0
# BINANCE_USE_PROXY=0
# BINANCE_HTTPS_PROXY=
DEEPCOIN_API_KEY=
DEEPCOIN_SECRET_KEY=
DEEPCOIN_PASSPHRASE=
OSTIUM_PRIVATE_KEY=

# ── Webhook / 钉钉 ──
WEBHOOK_SECRET=your-secret-key-here
DINGTALK_TOKEN=
DINGTALK_SECRET=

# ── 行情数据 ──
MASSIVE_API_KEY=

# ── AI 评分（可选）──
DEEPSEEK_SCORE_MODEL=deepseek-v4-flash
CRYPTO_SCORE_ENABLED=1

# ── 评分反馈学习（Chroma 向量库，钉钉 @ 纠正评分）──
SCORE_FEEDBACK_CHROMA_ENABLED=1
# SCORE_FEEDBACK_CHROMA_PATH=backpack_quant_trading/data/chroma_score_feedback
# 嵌入：auto（无 onnx 则 hash）| hash（零下载）| onnx（强制下 79MB 模型）
CHROMA_EMBEDDING_MODE=auto

# ── Agent 编排（钉钉多分析师 / 记忆 / 确认下单）──
AGENT_ORCH_ENABLED=1
# 独立 Agent Stream 机器人（推荐：与旧 OpenClaw 小钉评分机器人分开，互不抢连接）
# DINGTALK_AGENT_BOT_CLIENT_ID=
# DINGTALK_AGENT_BOT_CLIENT_SECRET=
# 独立 Agent 机器人默认关闭旧「信号评分」；若要在新机器人上也评分则设为 1
# DINGTALK_AGENT_ALLOW_LEGACY_SCORE=0
AGENT_MEMORY_CHROMA_ENABLED=1
# AGENT_EXEC_CONFIRM_TTL_MIN=30
# WEBHOOK_BASE=http://webhook:8005
# 小管家：钉钉 @小管家 → API 创建监视（与 WEBHOOK_SECRET 共用或单独设）
# AGENT_STEWARD_TOKEN=
# 小管家操作实盘实例绑定的平台用户 id（未设则取第一个 admin）
# AGENT_STEWARD_TRADE_USER_ID=
AGENT_API_BASE=http://api:8100
# 确认实盘必须：有效 WEBHOOK_SECRET + 已注册实例 ID（禁止广播）
# AGENT_EXEC_INSTANCE_ID=
# 钉钉问答加速（默认已偏快）
# AGENT_INCLUDE_RESEARCH=0
# AGENT_CRYPTO_FAST=1
# AGENT_CRYPTO_US_OVERLAY=0
# SCORE_FEEDBACK_TIMEOUT_SEC=3
# MASSIVE_RATE_LIMIT_RETRIES=3
# 日巡检（默认每天 09:00 北京时间钉钉推送）
AGENT_PATROL_ENABLED=1
AGENT_PATROL_HOUR=9
# 自动复盘：报告满 N 天且尚无新复盘时，每天 20:00 批量复盘推送
AGENT_AUTO_REVIEW_ENABLED=1
AGENT_AUTO_REVIEW_DAYS=3
# 周六泡沫周报生成成功后钉钉推送
AGENT_WEEKLY_DINGTALK=1
# 预期主机名（不一致则巡检告警，防多机抢 Stream）
# AGENT_EXPECTED_HOST=
# 实盘 Webhook 美股买入：额外推 Agent 报告（与旧评分并存）
# AGENT_SIGNAL_PUSH_ENABLED=0
# 替换旧「AI 信号评分」推送（未设置时：AGENT_ORCH_ENABLED=1 则默认替换）
# AGENT_REPLACE_LEGACY_PUSH=1
# AGENT_E2E_MOCK_LLM=0

# ── 旧评分 Stream（OpenClaw 小钉，可继续本机或其他进程使用）──
# DINGTALK_SCORE_BOT_CLIENT_ID=
# DINGTALK_SCORE_BOT_CLIENT_SECRET=
# DINGTALK_MANUAL_SCORE_ENABLED=1

# ── 加密密钥口令（若有 .env.secrets）──
# ENV_SECRETS_PASSPHRASE=
