# 正式机 /opt/backpack-quant/.env 模板（勿提交真实密钥）
# cp deploy/env.prod.example /opt/backpack-quant/.env

# ── 外部 MySQL（宿主机已有库；不要用 DB_HOST=mysql）──
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=backpack
DB_PASSWORD=请修改为强密码
DB_NAME=backpack

# ── 容器出站代理（宿主机 mihomo 需 allow-lan: true，监听非仅 127.0.0.1）──
# 构建镜像时不要把这两项设成 host.docker.internal（dockerd 解析不了）
# 宿主机构建请保持空；容器专用：
CONTAINER_HTTP_PROXY=http://172.17.0.1:7891
CONTAINER_HTTPS_PROXY=http://172.17.0.1:7891
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,webhook,dingtalk-agent,host.docker.internal,172.17.0.1

# ── 服务标识 ──
TRADING_SERVER=1
ENABLE_OKX_TRADE=true

# ── 交易所 API（按需）──
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
HYPERLIQUID_PRIVATE_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# 合约保证金模式：ISOLATED=逐仓（默认） / CROSSED=全仓
BINANCE_MARGIN_TYPE=ISOLATED

# ── Webhook / 钉钉 ──
WEBHOOK_SECRET=your-secret-key-here
DINGTALK_TOKEN=
DINGTALK_SECRET=
# 钉钉机器人默认关键词（多数群为「提醒」）；A 股监控专用机器人可另设下方关键词
# DINGTALK_KEYWORD=提醒

# ── A 股标的监控（币种监视）──
# STOCKAPI_TOKEN=
# A_SHARE_MONITOR_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# 该专用机器人当前关键词为「信号」（须与钉钉群机器人安全设置一致）
A_SHARE_MONITOR_DINGTALK_KEYWORD=信号

# ── Agent ──
AGENT_ORCH_ENABLED=1
AGENT_MEMORY_CHROMA_ENABLED=1
CHROMA_EMBEDDING_MODE=auto
AGENT_API_BASE=http://api:8100
WEBHOOK_BASE=http://webhook:8005
# AGENT_STEWARD_TOKEN=
# AGENT_STEWARD_TRADE_USER_ID=
# AGENT_EXEC_INSTANCE_ID=
AGENT_PATROL_ENABLED=1
AGENT_PATROL_HOUR=9
AGENT_AUTO_REVIEW_ENABLED=1
AGENT_AUTO_REVIEW_DAYS=3
AGENT_WEEKLY_DINGTALK=1
# 自动复盘 / 日巡检专用钉钉群（不配则回退 STOCK_NEWS_DINGTALK_WEBHOOK）
# AGENT_OPS_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# AGENT_EXPECTED_HOST=

# ── 小沫数字人 ──
# AVATAR_TTS_VOICE=zh-CN-XiaoyiNeural
# D-ID 免费试用 Key（Studio 里 username:password）；不配则只用静图+女声 TTS
# DID_API_KEY=
# DID_SOURCE_URL=
# Picovoice 免费层已停用
# PICOVOICE_ACCESS_KEY=

# ── A股 AI 自适应策略 Agent（独立群，不与 A 股监控混用）──
# A_SHARE_AI_AGENT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# A_SHARE_AI_AGENT_DINGTALK_KEYWORD=信号
